# DealDesk config — copy to .env and set DEALDESK_PASSWORD. Everything else is
# optional and better set from the in-app Settings page (it writes the DB, which
# OVERRIDES this file at runtime — so if an edit here seems to do nothing, the DB
# already holds that key; change it on /settings).
#
# NOTE: a comment must go ABOVE a blank key, never beside it. `KEY=  # note` makes
# the comment the value (python-dotenv only strips an inline comment after a value).

# --- single-user auth ---
DEALDESK_PASSWORD=changeme          # CHANGE THIS before exposing beyond localhost
# leave blank -> a random key is generated & printed on first run (logins reset on restart)
SECRET_KEY=
SESSION_HTTPS_ONLY=false           # set true behind HTTPS (adds Secure to the session cookie)

# --- AI (the agent, term extraction, drafting). Blank key -> rules/template fallback. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8          # or claude-haiku-4-5 for cheaper/faster

# --- email loop (stdlib IMAP/SMTP; BYO inbox). Gmail/Outlook need an APP PASSWORD. ---
# Defaults are Gmail; for Outlook use outlook.office365.com / smtp.office365.com:587.
EMAIL_USER=                        # full address, e.g. you@gmail.com
EMAIL_PASSWORD=                    # App Password, NOT your login password
EMAIL_FROM=                        # blank = same as EMAIL_USER
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- cost guardrail ---
MONTHLY_BUDGET_CENTS=1000          # hard cap on AI spend per calendar month
DB_PATH=dealdesk.db

# --- server ---
DEALDESK_PORT=8799                  # host port for run.sh / docker compose
